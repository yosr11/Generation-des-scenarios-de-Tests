{
  "story_id": "NUXEPM-1432",
  "user_story": {
    "title": "RH de proximité - Démarche - Poser une question RH",
    "description": "En tant que RH de proximité, je souhaite poser une question RH pour un collaborateur de ma population afin de l'envoyer à un gestionnaire pour traitement. La démarche s'affiche dans le widget Processus RH, permet la recherche d'un bénéficiaire de la population, l'envoi de la demande avec ou sans information au bénéficiaire, et le suivi dans les onglets En cours et Historique.",
    "priority": "P1-High",
    "labels": [
      "EX_STREAM_COREAPP",
      "STREAM_APPLICATIF"
    ]
  },
  "gold_tests": {
    "key": "YOUQA-15113",
    "summary": "RHDEPROXIMITE_S1_ST1_C1 - Poser une question RH depuis le widget Processus RH pour le compte d'un bénéficiaire",
